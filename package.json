{
  "name": "@xtruder/opencode-claude-max-plugin",
  "version": "0.4.6",
  "description": "OpenCode plugin for Claude Max/Pro subscription via @anthropic-ai/sdk - uses Claude Code OAuth credentials",
  "keywords": [
    "ai-sdk",
    "anthropic",
    "claude",
    "opencode",
    "provider"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtruder/opencode-claude-max-plugin.git"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./server": {
      "import": "./build/server.js"
    },
    "./tui": {
      "import": "./build/tui.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir build",
    "dev": "vite build --watch",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "test:live": "CLAUDE_LIVE_TESTS=1 npm test",
    "test:tui-smoke": "uv run --with pexpect --with pyte python scripts/tui-smoke.py",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.94.0",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "solid-js": "1.9.12",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "3.0.2",
    "@opencode/plugin": "2.0.16",
    "@opencode/theme": "2.0.16",
    "@types/node": "^26.6.2",
    "ai": "^6.0.146",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=2.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run format:check"
  },
  "engines": {
    "node": ">=26.4.0",
    "opencode": ">=2.0.16"
  }
}
